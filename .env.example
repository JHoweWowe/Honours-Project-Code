# MongoDB Atlas credentials (required)
FOOD_RECIPE_DATABASE_USERNAME=your_username
FOOD_RECIPE_DATABASE_PASSWORD=your_password
FOOD_RECIPE_DATABASE_HOSTNAME=cluster0.xxxxx.mongodb.net

# Flask session signing (required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth credentials (required for login)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# Admin email — users with this email see the Admin panel (defaults to howejust@gmail.com if unset)
ADMIN_EMAIL=howejust@gmail.com

# Google Analytics 4 — set to your G-XXXXXXXXXX measurement ID to enable (leave blank to disable)
GA4_MEASUREMENT_ID=

# Geoapify API key — required for "Find Ingredients Near You" store locator (P6)
GEOAPIFY_API_KEY=your_geoapify_key

# Spoonacular API key — required for price batch refresh job (P20)
SPOONACULAR_API_KEY=your_spoonacular_key

# Redis URL — set by Heroku Redis add-on automatically; enables shared cache across Gunicorn workers (P11)
# Leave unset in local dev to use SimpleCache (per-process, in-memory)
REDIS_URL=
